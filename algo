#!/usr/bin/env bash

set -e

# Install Ansible Galaxy collections if requirements.yml exists
# This is needed for cloud providers that use collection modules (Linode, DigitalOcean, Azure, etc.)
if [ -f "requirements.yml" ]; then
    uv run ansible-galaxy collection install -r requirements.yml > /dev/null 2>&1 || true
fi

# Run the appropriate playbook
case "${1:-}" in
  destroy)
    uv run ansible-playbook destroy.yml "${@:2}" ;;
  switch-dns)
    # ./algo switch-dns [server-name] [ansible options]; the name defaults to server_name in config.cfg
    if [ -n "${2:-}" ] && [[ "$2" != -* ]]; then
      uv run ansible-playbook switch-dns.yml -e "server_name=$2" "${@:3}"
    else
      uv run ansible-playbook switch-dns.yml "${@:2}"
    fi ;;
  *)
    uv run ansible-playbook main.yml "${@}" ;;
esac
