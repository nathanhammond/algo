{% set iface = ansible_facts['default_ipv4']['interface'] %}
{% set vpn = wireguard_network_ipv4 %}
{% set ports = [wireguard_port] + ([wireguard_port_actual] if wireguard_port | int == wireguard_port_avoid | int else []) %}

#### The nat table
*nat

:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

{% if wireguard_port | int == wireguard_port_avoid | int %}
# WireGuard on a port that is already in use, like 53: VPN clients keep it,
# and everyone else is sent to WireGuard's real port
-A PREROUTING -s {{ vpn }} -p udp --dport {{ wireguard_port_avoid }} -j RETURN
-A PREROUTING --in-interface {{ iface }} -p udp --dport {{ wireguard_port_avoid }} -j REDIRECT --to-port {{ wireguard_port_actual }}
{% endif %}
# NAT traffic from the VPN to the internet
-A POSTROUTING -s {{ vpn }} -o {{ iface }} -j MASQUERADE

COMMIT


#### The filter table
*filter

# Drop packets to and through this server unless a rule below accepts them
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
# Ping, rate limited per source
-A INPUT -p icmp --icmp-type echo-request -m hashlimit --hashlimit-upto 5/s --hashlimit-mode srcip --hashlimit-srcmask 32 --hashlimit-name icmp-echo-drop -j ACCEPT
# WireGuard
-A INPUT -p udp -m multiport --dports {{ ports | join(',') }} -j ACCEPT
# SSH
-A INPUT -p tcp --dport {{ ansible_ssh_port }} -m conntrack --ctstate NEW -j ACCEPT
# DNS to the local resolver, from VPN clients only
-A INPUT -i wg0 -s {{ vpn }} -d {{ local_service_ip }} -p udp --dport 53 -j ACCEPT

# Traffic between VPN clients
-A FORWARD -s {{ vpn }} -d {{ vpn }} -j {{ "DROP" if BetweenClients_DROP else "ACCEPT" }}
# The link-local network, which includes the cloud metadata service
-A FORWARD -s {{ vpn }} -d 169.254.0.0/16 -j DROP

-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
# SMB/CIFS and NetBIOS
-A FORWARD -p tcp --dport 445 -j {{ "DROP" if block_smb else "ACCEPT" }}
-A FORWARD -p udp -m multiport --ports 137,138 -j {{ "DROP" if block_netbios else "ACCEPT" }}
-A FORWARD -p tcp -m multiport --ports 137,139 -j {{ "DROP" if block_netbios else "ACCEPT" }}

# New connections from VPN clients
-A FORWARD -i wg0 -m conntrack --ctstate NEW -s {{ vpn }} -j ACCEPT

COMMIT
