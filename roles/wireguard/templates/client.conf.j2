[Interface]
PrivateKey = {{ lookup('file', wireguard_pki_path + '/private/' + item) }}
Address = {{ wireguard_client_ip }}
DNS = {{ wireguard_dns_servers }}
{% if reduce_mtu | int > 0 %}MTU = {{ 1420 - reduce_mtu | int }}
{% endif %}

[Peer]
PublicKey = {{ lookup('file', wireguard_pki_path + '/public/' + IP_subject_alt_name) }}
PresharedKey = {{ lookup('file', wireguard_pki_path + '/preshared/' + item) }}
AllowedIPs = 0.0.0.0/0,::/0
Endpoint = {{ endpoint_hostname | default('', true) or (('[' + IP_subject_alt_name + ']') if ':' in IP_subject_alt_name else IP_subject_alt_name) }}:{{ wireguard_port }}
{# A block tag ending a line also removes its newline, so the Endpoint line above uses only an expression #}
{% if wireguard_PersistentKeepalive | int > 0 %}
PersistentKeepalive = {{ wireguard_PersistentKeepalive | int }}
{% endif %}
