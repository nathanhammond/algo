{#- Answers containing these addresses are blocked (DNS rebinding protection).
    dnscrypt-proxy matches a trailing * as a prefix of the address as text.
    dns_records are answered by cloaking, which is not affected. -#}
{% set v4 = ['0.*', '10.*', '127.*', '169.254.*', '192.168.*']
           + range(16, 32) | map('regex_replace', '^(.*)$', '172.\\1.*') | list
           + range(64, 128) | map('regex_replace', '^(.*)$', '100.\\1.*') | list %}
{% for p in v4 %}
{{ p }}
{% endfor %}
{% for p in v4 %}
::ffff:{{ p }}
{% endfor %}
